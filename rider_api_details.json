{
  "/api/admin/orders/{orderId}/assign-rider": {
    "post": {
      "summary": "Manually assign a rider to an order (admin panel)",
      "parameters": [
        {
          "name": "orderId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "requestBody": {
        "$ref": "#/components/schemas/RallyAPI.Users.Endpoints.Admins.AdminAssignRider.AdminAssignRiderRequest"
      }
    }
  },
  "/api/admins/riders": {
    "post": {
      "requestBody": {
        "$ref": "#/components/schemas/RallyAPI.Users.Endpoints.Admins.CreateRider.CreateRiderRequest"
      }
    },
    "get": {
      "summary": "List all riders with optional filtering by online status and KYC status",
      "parameters": [
        {
          "name": "isOnline",
          "in": "query",
          "schema": {
            "type": "boolean"
          }
        },
        {
