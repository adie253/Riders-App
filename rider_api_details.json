          "in": "query",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "page",
          "in": "query",
          "schema": {
            "type": "integer",
            "format": "int32",
            "default": 1
          }
        },
        {
          "name": "pageSize",
          "in": "query",
          "schema": {
            "type": "integer",
            "format": "int32",
            "default": 20
          }
        }
